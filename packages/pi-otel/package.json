{
  "name": "@mammothb/pi-otel",
  "version": "0.0.0",
  "description": "OpenTelemetry traces and metrics for the pi coding harness, exported via OTLP/HTTP to Grafana otel-lgtm",
  "keywords": [
    "pi-package",
    "opentelemetry",
    "otel",
    "telemetry",
    "tracing",
    "metrics",
    "observability"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "CONTEXT.md",
    "dashboards",
    "samples"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@mammothb/pi-shared": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
