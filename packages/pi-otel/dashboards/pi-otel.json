{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "title": "Token Usage",
      "type": "row"
    },
    {
      "type": "timeseries",
      "title": "Token rate by model (tokens/min)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tokens"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (gen_ai_token_type, gen_ai_request_model) (rate(gen_ai_client_token_usage_sum[5m]) * 60)",
          "legendFormat": "{{gen_ai_token_type}} {{gen_ai_request_model}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Operation duration p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_operation_name) (rate(gen_ai_client_operation_duration_bucket[1h])))",
          "legendFormat": "p95 {{gen_ai_operation_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, gen_ai_operation_name) (rate(gen_ai_client_operation_duration_bucket[1h])))",
          "legendFormat": "p50 {{gen_ai_operation_name}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": [],
      "title": "Tool Usage",
      "type": "row"
    },
    {
      "type": "piechart",
      "title": "Tool call distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 0,
        "y": 10
      },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum by (pi_tool_name) (pi_tool_calls_total)",
          "legendFormat": "{{pi_tool_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool calls by name (calls/min)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 5,
        "y": 10
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (pi_tool_name) (rate(pi_tool_calls_total[5m]) * 60)",
          "legendFormat": "{{pi_tool_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tool error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 10,
        "y": 10
      },
      "id": 4,
      "targets": [
        {
          "expr": "(sum by (pi_tool_name) (rate(pi_tool_calls_total{pi_tool_is_error=\"true\"}[5m])) or (sum by (pi_tool_name) (rate(pi_tool_calls_total[5m])) * 0)) / clamp_min(sum by (pi_tool_name) (rate(pi_tool_calls_total[5m])), 0.0001)",
          "legendFormat": "{{pi_tool_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Tool execution duration (distribution)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": {
              "graph": false,
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineWidth": 1,
            "axisSoftMin": 0,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "axisCenteredZero": false,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "id": 8,
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "percent",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0,
        "fullHighlight": false,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "hideZeros": false,
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (pi_tool_name) (rate(pi_tool_duration_bucket{le=\"10\"}[1h]))",
          "format": "table",
          "instant": true,
          "refId": "A1"
        },
        {
          "expr": "sum by (pi_tool_name) (rate(pi_tool_duration_bucket{le=\"100\"}[1h]) - ignoring(le) rate(pi_tool_duration_bucket{le=\"10\"}[1h]))",
          "format": "table",
          "instant": true,
          "refId": "A2"
        },
        {
          "expr": "sum by (pi_tool_name) (rate(pi_tool_duration_bucket{le=\"1000\"}[1h]) - ignoring(le) rate(pi_tool_duration_bucket{le=\"100\"}[1h]))",
          "format": "table",
          "instant": true,
          "refId": "A3"
        },
        {
          "expr": "sum by (pi_tool_name) (rate(pi_tool_duration_bucket{le=\"10000\"}[1h]) - ignoring(le) rate(pi_tool_duration_bucket{le=\"1000\"}[1h]))",
          "format": "table",
          "instant": true,
          "refId": "A4"
        },
        {
          "expr": "sum by (pi_tool_name) (rate(pi_tool_duration_bucket{le=\"300000\"}[1h]) - ignoring(le) rate(pi_tool_duration_bucket{le=\"10000\"}[1h]))",
          "format": "table",
          "instant": true,
          "refId": "A5"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A1": "0-10ms",
              "Value #A2": "10-100ms",
              "Value #A3": "100ms-1s",
              "Value #A4": "1-10s",
              "Value #A5": ">10s",
              "pi_tool_name": "Tool"
            }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": [],
      "title": "Agent Activity",
      "type": "row"
    },
    {
      "type": "timeseries",
      "title": "Prompts / turns (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(pi_prompt_count_total[5m]))",
          "legendFormat": "prompts",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pi_turn_count_total[5m]))",
          "legendFormat": "turns",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Session duration p50/p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pi_session_duration_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(pi_session_duration_bucket[1h])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": [],
      "title": "Traces",
      "type": "row"
    },
    {
      "type": "table",
      "title": "Recent sessions (traces)",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 7,
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "/explore?left=%7B%22datasource%22:%22${tempo}%22,%22queries%22:%5B%7B%22refId%22:%22A%22,%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22%7D%5D%7D"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "limit": 20,
          "query": "{ resource.service.name = \"pi\" }",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "options": {
        "footer": {
          "enablePagination": true
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 40,
  "tags": ["pi", "otel", "llm"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Tempo datasource",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "text": "Tempo",
          "value": "Tempo"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "pi-otel",
  "uid": "pi-otel",
  "version": 16
}
