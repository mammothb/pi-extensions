{
  "name": "@mammothb/pi-read",
  "version": "0.2.1",
  "description": "Smart read for pi — AST outlines for large files via optional tree-sitter WASM grammars, delegating everything else to the built-in read",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@mammothb/pi-shared": "workspace:*"
  },
  "optionalDependencies": {
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.12"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
